{# @block content The default block #}
<div
    id="{{ _accordion_item_id }}-content"
    role="region"
    aria-labelledby="{{ _accordion_item_id }}-trigger"
    class="overflow-hidden text-sm"
>
    <div class="{{ 'pt-0 pb-4 ' ~ attributes.render('class')|tailwind_merge }}" {{ attributes }}>
        {%- block content %}{% endblock -%}
    </div>
</div>
