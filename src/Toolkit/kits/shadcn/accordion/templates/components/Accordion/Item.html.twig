{# @prop value string Unique identifier for the accordion item #}
{# @prop open boolean Whether the item is open by default, default to `false` #}
{# @block content The default block #}
{%- props value, open = false -%}

{%- set _accordion_item_id = 'accordion-item-' ~ value -%}
<details
    class="{{ 'group border-b last:border-b-0 ' ~ attributes.render('class')|tailwind_merge }}"
    data-accordion-target="item"
    {% if open %}open{% endif %}
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</details>
